# ---- تنظیمات سرور بدنه پلاس ----
# این فایل را به ‎.env‎ کپی کنید و مقداردهی کنید:  cp .env.example .env

# توکن ربات تلگرام (از @BotFather)
BOT_TOKEN=

# آدرس سایت
BASE_URL=https://badaneplus.com

# پورت سرور Node (پشت nginx)
PORT=8083

