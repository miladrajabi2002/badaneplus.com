[Unit]
Description=BadanePlus Telegram Management Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/badaneplus.com/bot
ExecStart=/var/www/badaneplus.com/bot/venv/bin/python bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=badaneplus-bot

[Install]
WantedBy=multi-user.target
